        "discussion" : {
            "title": "Object's Flexibility",
            "description": "Moving air applies force to objects. Paper bends due to flexibility (plasticity), and repeated bending can weaken it.",
            "Tip": "Approximate force using F ≈ k ⋅ 𝜃. Students can rank forces by stiffness and bend angle without exact units if needed."
        },
        
        "optionalChallenge": {
            "description": "Estimate a stiffness coefficient 𝑘 for each material by measuring bend angle under a constant fan speed.",
            "cases" : [
                {
                "id": 1,
                "title": "What 𝒌 is",
                "description": "For bending a sheet of paper:",
                "formula": "F ≈ k ⋅ 𝜃",
                "legend": [
                    {
                    "variable": "F",
                    "definition": "force applied (N)"
                    },
                    {
                    "variable": "k",
                    "definition": "stiffness coefficient, representing resistance to bending"
                    },
                    {
                    "variable": "𝜃",
                    "definition": "bend angle (radians)"
                    }
                ],
                "context": "In reality, k is related to flexural rigidity D = (Et³) / (12(1-v²)), but for classroom experiments we can use approximate empirical values."
                },
                {
                    "id": 2,
                    "title": "Approximate 𝒌 values for different papers",
                    "materialTable": {
                        "columns": [
                            "Material",
                            "Thickness (mm)",
                            "Stiffness k (N/rad)",
                            "Notes"
                        ],
                        "rows": [
                            {
                                "id": 1,
                                "material": "Thin printer paper",
                                "thickness": 0.1,
                                "stiffness": 0.05,
                                "note": "Bends very easily"
                            },
                            {
                                "id": 2,
                                "material": "Standard card stock",
                                "thickness": 0.25,
                                "stiffness": 0.2,
                                "note": "Moderate bend"
                            },
                            {
                                "id": 3,
                                "material": "Thin cardboard",
                                "thickness": 0.5,
                                "stiffness": 0.5,
                                "note": "Much harder to bend"
                            },
                            {
                                "id": 4,
                                "material": "Corrugated cardboard",
                                "thickness": 3.0,
                                "stiffness": 2.5,
                                "note": "Very stiff, almost no bend"
                            }
                        ]
                    },
                    "context": "These are rough classroom values to let students estimate forces. The point is to see relative differences between materials."
                },
                {
                    "id": 3,
                    "title": "Example calculation",
                    "example": [
                        "Thin paper, k = 0.05 N/rad",
                        "Bend angle observed: 30° → 𝜃 = 30∘ ≈ 0.524 rad",
                        "F ≈ k ⋅ 𝜃 = 0.05 ⋅ 0.524 ≈ 0.026 N",
                        "For thicker cardboard, k = 0.5, same bend angle:",
                        "F ≈ 0.5 ⋅ 0.524 ≈ 0.26 N"
                    ],
                    "context": "So, the force required increases strongly with stiffness."
                }
            ]
        },

