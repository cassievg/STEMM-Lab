{
  "expo": {
    "name": "STEMM-Lab",
    "slug": "STEMM-Lab",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "stemmlab",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stemmlab",
      "googleServicesFile": "GoogleService-Info.plist"
    },
    "android": {
      "package": "com.stemmlab",
      "googleServicesFile": "google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-image-picker",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-font",
      "expo-video",
      "expo-sqlite",
      "expo-maps",
      "expo-asset",
      "react-native-google-mobile-ads"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "25ce6a33-2666-4030-a5fb-390253f61d99"
      }
    }
  },
    "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-9263495687323879~5794919594",
    "ios_app_id": "ca-app-pub-xxxxxxxx~xxxxxxxx"
  }
}
