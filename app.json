{
  "expo": {
    "name": "STEMM-Lab",
    "slug": "STEMM-Lab",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "stemmlab",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stemmlab",
      "googleServicesFile": "GoogleService-Info.plist"
    },
    "android": {
      "package": "com.stemmlab",
      "googleServicesFile": "google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-image-picker",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-font",
      "expo-video",
      "expo-sqlite",
      "expo-maps",
      "expo-asset",
      ["react-native-google-mobile-ads",
      {
        "androidAppId": "ca-app-pub-9263495687323879~5794919594",
        "iosAppId": "ca-app-pub-9263495687323879~1298442246"
      }],
      ["expo-location",
      {
        "locationAlwaysAndWhenInUsePermission": "STEMM Lab needs location to track sound zones during activities."
      }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "25ce6a33-2666-4030-a5fb-390253f61d99"
      }
    }
  }
}
